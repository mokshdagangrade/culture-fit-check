LLM_API_KEY=
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
MONGODB_URI=mongodb://localhost:27017/
JWT_SECRET=

HF_TOKEN=

LLM_PROVIDER_CHAIN=true
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507
GEMINI_API_KEY=
GROQ_API_KEY=

# Enable after training and serving the adapter. Keep blank for existing providers.
GENERATION_BASE_URL=
GENERATION_MODEL=
GENERATION_API_KEY=

# Hosted images only; reuses HF_TOKEN, no model download.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_IMAGE_PROVIDER=auto

# Cloudflare hosted FLUX (preferred for images when FLUX_KEY is set).
# FLUX_KEY must be a Cloudflare API token with Workers AI access.
FLUX_KEY=
CLOUDFLARE_ACCOUNT_ID=
